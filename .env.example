# Fill in locally, never commit real values to Git.
MYSQL_ROOT_PASSWORD=replace-with-random-root-password
MYSQL_PASSWORD=replace-with-random-app-password
MYSQL_PORT=13384
DATABASE_URL=mysql://wbadmin:replace-with-random-app-password@db:3306/wbengine_admin
MASTER_KEY=replace-with-64-hex-characters-from-random-32-bytes
ORIGIN=https://admin.example.com
# Optional exact IP addresses, after operations approve an intranet target.
# No CIDR ranges, hostnames or global allowPrivate.
REMOTE_IP_ALLOWLIST=
# Optional invitation mail (SMTP, for Google an app password). Leave empty to hand codes over manually.
# The feature is on only when host, user, password and sender are all set.
MAIL_SMTP_HOST=
MAIL_SMTP_PORT=587
MAIL_SMTP_USER=
MAIL_SMTP_PASSWORD=
MAIL_FROM=
