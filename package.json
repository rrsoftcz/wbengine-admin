{
  "name": "wbengine-admin",
  "version": "0.2.0",
  "private": true,
  "license": "MIT",
  "type": "module",
  "engines": {
    "node": ">=22.18"
  },
  "scripts": {
    "dev": "vite dev --host 0.0.0.0",
    "build": "vite build",
    "check": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json",
    "test": "node --experimental-strip-types --test tests/*.test.ts",
    "test:integration": "node --experimental-strip-types --test tests/mysql.integration.ts",
    "admin": "node --experimental-strip-types scripts/admin.ts",
    "test:mysql": "npm run build && node --experimental-strip-types scripts/test-mysql.ts"
  },
  "dependencies": {
    "mysql2": "3.24.6",
    "qrcode-generator": "2.0.4"
  },
  "devDependencies": {
    "@sveltejs/adapter-node": "6.0.0",
    "@sveltejs/kit": "3.1.0",
    "@tailwindcss/vite": "4.3.3",
    "@types/node": "26.6.5",
    "svelte": "5.57.2",
    "svelte-check": "4.7.7",
    "tailwindcss": "4.3.3",
    "typescript": "6.0.3",
    "vite": "8.3.5"
  },
  "imports": {
    "#lib/*": "./src/lib/*"
  }
}
